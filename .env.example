# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=avatar-system-storage
CLOUDFRONT_DOMAIN=

# Database Configuration
# Hostnames here are for running the backend directly on this machine. Under
# docker compose they are overridden with the service names automatically.
DATABASE_URL=postgresql://avatar_user:change_this_password@localhost:5432/avatar_db
DATABASE_NAME=avatar_db
DATABASE_USER=avatar_user
DATABASE_PASSWORD=change_this_password

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Application Settings
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# LLM Configuration
# anthropic | openai | ollama (local & free — runs against http://localhost:11434/v1)
LLM_PROVIDER=anthropic
# Claude: claude-sonnet-5-5 (default) | claude-opus-5-5 | claude-haiku-5-5
# OpenAI: e.g. gpt-4o, gpt-4o-mini (also requires LLM_PROVIDER=openai)
# Ollama: e.g. llama3.1, qwen2.5 (requires LLM_PROVIDER=ollama)
LLM_MODEL=claude-sonnet-5-5
# Optional: point the OpenAI-compatible client elsewhere (Ollama, vLLM,
# LM Studio, OpenRouter). Leave empty for api.openai.com.
OPENAI_BASE_URL=
# OpenAI-compatible providers only; the Claude API no longer accepts
# sampling parameters.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
# Claude 4.7+ only: low | medium | high | xhigh | max. "low" keeps the pause
# before the avatar speaks short.
LLM_EFFORT=low
# OpenAI-compatible reasoning models (e.g. Ollama cloud glm-*/kimi-*): set to
# "none" so they answer in `content`. Leave empty otherwise.
LLM_REASONING_EFFORT=

# Load the speech and lip-sync models at startup instead of on the first turn.
# Leave off in development; turn on wherever people are waiting.
PRELOAD_MODELS=false

# Face restoration (optional, GPU only)
# MuseTalk regenerates the mouth at 256x256 while the avatar is stored at
# AVATAR_RESOLUTION (512), so the mouth is about half the resolution of the
# face around it. GFPGAN sharpens the composited frame back up.
# Costs real time per frame — measure the FPS trade before leaving it on.
# Setup: bash scripts/setup_face_restore.sh
FACE_RESTORE=off                  # off | gfpgan

# Avatar Engine
#   musetalk   — default, ~30 FPS on 16-24 GB
#   liveavatar — higher fidelity, needs 48 GB+ VRAM and loads a 14B model per
#                turn (minutes). Offline renders only. bash scripts/setup_liveavatar.sh
#   simple     — ffmpeg static image + audio, CPU, no lip-sync
AVATAR_ENGINE=musetalk
AVATAR_RESOLUTION=512
AVATAR_FPS=25
MUSETALK_PATH=models/MuseTalk

# Storage. Local disk by default (served at /uploads); set false to use S3.
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=uploads
# Generated clips older than this are deleted from LOCAL storage by the daily
# cleanup. 0 keeps them forever. (On S3, use a lifecycle rule on videos/.)
MEDIA_RETENTION_HOURS=24

# How media reaches the browser.
#   clips  — default: one MP4 per sentence over HTTP. Works everywhere.
#   webrtc — one continuous audio+video stream; no stutter between sentences
#            and instant interruption. Needs the backend reachable from the
#            browser over UDP: fine when running on the host, but NOT through
#            a default Docker bridge network. In a container, either give the
#            backend host networking (network_mode: host) or add a TURN relay
#            below. Publishing a UDP port range does not work: the ports are
#            kernel-assigned and no setting bounds them.
#            Costs CPU (up to a third of a core per connected session
#            while speaking, about a fifth idle) and up to ~235 MB of RAM
#            per speaking session.
#            Sessions that cannot connect, or whose stream fails later, fall
#            back to clips on their own.
MEDIA_TRANSPORT=clips
# STUN/TURN servers (JSON list, also sent to the browser). Users behind
# strict NATs need a TURN relay, e.g.
#   [{"urls":["turn:turn.example.com:3478"],"username":"u","credential":"p"}]
WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]

# STT Configuration
STT_PROVIDER=whisper
# tiny | base | small | medium | large-v3 | large-v3-turbo
# large-v3-turbo: best 2026 sweet spot — recommended for GPU. Fall back to base/small on CPU.
WHISPER_MODEL=large-v3-turbo
# 1 = greedy, fastest. Raise (e.g. 5) to trade latency for accuracy.
WHISPER_BEAM_SIZE=1

# TTS Configuration
# chatterbox | edge | gtts
# chatterbox (voice cloning, 23 languages) is OPTIONAL and ships in
# backend/requirements-tts.txt, which needs its own virtualenv — it pins a
# newer torch/transformers than the MuseTalk pipeline can use. When it isn't
# installed, synthesis uses edge-tts (free neural voices) and then gtts; set
# TTS_PROVIDER=edge to make that the configured engine.
TTS_PROVIDER=chatterbox

# Security
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Conversation memory
# Turns falling out of the context window are folded into a running summary
# carried in the system prompt, so long conversations keep their thread.
# One background LLM call per overflow (~every 10 turns once a conversation
# passes 30), not per reply.
CONVERSATION_MEMORY=true
MEMORY_SUMMARY_MAX_CHARS=1500

# Auth cookie. Set AUTH_COOKIE_SECURE=true wherever the site is served over
# HTTPS (required when ENVIRONMENT=production).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Guest accounts
# "Continue as Guest" mints a real but anonymous user row so each guest's
# data is scoped to them alone. Idle guests — and their avatars and clips —
# are deleted by the daily cleanup_guest_accounts task. A guest who sets an
# email and password becomes a normal account. Set false to require sign-up.
GUEST_ACCOUNTS_ENABLED=true
GUEST_RETENTION_HOURS=48

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# WebSocket
# Turns (text or voice) one user may start per minute. 0 disables the limit.
WS_TURNS_PER_MINUTE=30
WS_MAX_CONNECTIONS=1000
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# File Upload — both are enforced on /api/v1/avatars/upload. MAX_UPLOAD_SIZE
# is applied while streaming the body, so an oversized request is rejected
# with 413 instead of being buffered in memory first.
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
MAX_VOICE_UPLOAD_SIZE=20971520

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# Frontend URL
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
