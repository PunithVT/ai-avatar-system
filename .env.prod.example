# ============================================================
# Production Environment — copy to .env.prod and fill in values
# ============================================================

# AWS
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-avatar-bucket
CLOUDFRONT_DOMAIN=

# Database  (RDS recommended in production)
DATABASE_URL=postgresql://avatar_user:STRONG_PASSWORD@postgres:5432/avatar_db
DATABASE_NAME=avatar_db
DATABASE_USER=avatar_user
DATABASE_PASSWORD=STRONG_PASSWORD_HERE

# Redis  (ElastiCache recommended in production)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# API Keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# Application
SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# Load models when the server starts, so the first person to speak after a
# deploy does not wait a minute or more for them.
PRELOAD_MODELS=true
# Keep this at 1: each server process loads its own models and holds its own
# sessions. Scale with more backend containers, not more workers.
UVICORN_WORKERS=1

# Avatar Engine — musetalk for GPU lip-sync, simple for fallback
AVATAR_ENGINE=musetalk
AVATAR_RESOLUTION=512
AVATAR_FPS=25
# Lip-sync frames go onto the WebRTC stream as they are generated (webrtc +
# musetalk only). Cuts the wait before each sentence's first frame; a
# sentence is only started early while the engine is measurably faster than
# playback (see /health -> lipsync_fps). Not yet exercised on a GPU.
LIPSYNC_PROGRESSIVE=false
MUSETALK_PATH=models/MuseTalk

# Storage. Local disk suits a single host: docker-compose.prod.yml mounts
# backend/uploads and nginx serves it at /uploads. For S3 set this to false
# and set CLOUDFRONT_DOMAIN — objects are private, so without CloudFront the
# stored avatar-image URLs are not fetchable by a browser.
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=uploads
MEDIA_RETENTION_HOURS=24

# How media reaches the browser: clips (MP4 per sentence over HTTP, through
# nginx like everything else) or webrtc (one continuous stream, no stutter
# between sentences). Leave on clips unless you have done BOTH of these:
#   1. made the backend reachable from browsers over UDP — the stack
#      publishes only nginx, and WebRTC media does not go through it. Run
#      the backend container with network_mode: host and allow inbound UDP
#      to the host in the firewall / security group. (There is no port range
#      to publish instead: each connection takes a kernel-assigned ephemeral
#      port and no setting bounds them. Without host networking, the only
#      route is the TURN relay in 2, for every user.)
#   2. added a TURN relay below for users behind strict NATs and corporate
#      firewalls, who cannot be reached directly whatever you open.
# Budget for it too: each connected session costs up to about a third of a
# core while the avatar speaks and a fifth of one while idle (for as long as
# the tab is open), and up to ~235 MB of RAM while speaking.
# Sessions that fail to connect, or whose stream fails later, fall back to
# clips automatically.
MEDIA_TRANSPORT=clips
# JSON list, also sent to browsers. TURN example:
#   [{"urls":["turn:turn.example.com:3478"],"username":"u","credential":"p"}]
WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
# Hands-free turn-taking on the WebRTC transport (no effect on clips). The
# microphone goes up the same peer connection and the server decides when
# the user has finished:
#   smart — Silero VAD + the Smart Turn end-of-turn model: a finished
#           sentence is answered at once, a pause mid-sentence is waited out
#   vad   — Silero VAD only: a turn ends after VAD_STOP_SECS of silence
#   off   — keep hands-free in the browser (loudness-based), as on clips
VOICE_TURN_DETECTION=smart
# Silence before the VAD reports that speech stopped. 0 = the default for
# the mode: 0.2 in smart (the pause after which the model is asked), 0.8 in
# vad (the silence that ends the turn — lower is faster and cuts people off).
VAD_STOP_SECS=0
# smart only: how long to wait for more after a pause that sounded
# unfinished, before answering anyway.
TURN_MAX_WAIT_SECS=3.0
# Running transcript while the user is still speaking. Each update is a full
# Whisper pass over the utterance so far.
#   auto — only when speech-to-text runs on a GPU   | on | off
STT_PARTIALS=auto
STT_PARTIAL_INTERVAL_SECS=1.5
# Streaming speech-to-text for the same microphone (default: off).
#   off    — Whisper transcribes each utterance when it ends
#   sherpa — sherpa-onnx + NVIDIA Nemotron 3.5 ASR Streaming: words appear
#            while the user speaks and the final text is ready ~0.2 s after
#            the last word. Runs on CPU. Costs a ~630 MB model in RAM (one
#            copy for all sessions) and about a quarter of real time across
#            STT_STREAMING_THREADS cores per speaking user.
# Needs the model: bash scripts/setup_streaming_stt.sh (475 MB download).
# Used for en es fr it pt nl de tr ru ar hi ja ko vi uk; sessions in other
# languages, and every utterance if the model is missing, keep using Whisper.
STT_STREAMING=off
# Relative paths are tried as given, then against backend/.
STT_STREAMING_MODEL_DIR=models/stt/sherpa-onnx-nemotron-3.5-asr-streaming-0.6b-560ms-int8-2026-06-11
# CPU cores one decode may use.
STT_STREAMING_THREADS=4

# LLM
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_EFFORT=low

# TTS — chatterbox is the current engine (the old "coqui" value still
# aliases to it, but name it directly). It is optional and needs its own
# virtualenv from backend/requirements-tts.txt; when absent, synthesis falls
# back to edge-tts and then gtts, losing only voice cloning.
# supertonic — Supertonic 3, a local CPU engine (ONNX): speech without any
# network call. Preset voices, no cloning. Speaks ar da de el en es fi fr hi
# it ja ko nl pl pt ru sv tr; other languages keep using edge-tts -> gtts.
# Optional, not the default: its weights (~400 MB) download from Hugging Face
# on first use (to ~/.cache/supertonic3, or SUPERTONIC_CACHE_DIR), they are
# licensed BigScience OpenRAIL-M (royalty-free, but with use restrictions you
# must pass on to your users), and upstream is archived (no future fixes).
TTS_PROVIDER=chatterbox
# Supertonic only. Voice: F1-F5 or M1-M5. Steps trade quality for speed
# (5 is ~0.2-0.3x real time on a laptop CPU; 8 is cleaner and slower).
SUPERTONIC_VOICE=F1
SUPERTONIC_STEPS=5

# STT
STT_PROVIDER=whisper
WHISPER_MODEL=large-v3-turbo
WHISPER_BEAM_SIZE=1

# Public URLs (your domain / the host's public address — the nginx origin).
# The frontend is BUILT with these, so start the stack with
# `--env-file .env.prod` (see README) or they fall back to localhost.
BACKEND_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
# The WebSocket URL is derived from BACKEND_URL (https → wss). Set this only
# if sockets are served from a different origin.
WS_URL=
CORS_ORIGINS=https://yourdomain.com

# Security
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Auth cookie. Secure=true keeps the JWT off plain-HTTP requests and is
# REQUIRED in production — the app refuses to start without it when
# ENVIRONMENT=production (see Settings._validate_production_hardening).
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# Set when the API and frontend live on different subdomains of one site,
# e.g. ".yourdomain.com". Leave empty for a single host.
AUTH_COOKIE_DOMAIN=

# Guest accounts — see .env.example. Set false to require sign-up.
GUEST_ACCOUNTS_ENABLED=true
GUEST_RETENTION_HOURS=48

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
WS_TURNS_PER_MINUTE=30
