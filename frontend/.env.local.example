# Frontend environment — copy to .env.local (git-ignored) and adjust.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time and
# are therefore PUBLIC. Never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Only needed when serving avatar media from S3/CloudFront rather than the
# backend's local /uploads mount (see USE_LOCAL_STORAGE in the root .env).
NEXT_PUBLIC_S3_BUCKET_DOMAIN=
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=
